def config_path(override):
    if override:
        return Path(override)
    env = os.environ.get('TDIFF_CONFIG')
    if env:
        return Path(env)
    xdg = os.environ.get('XDG_CONFIG_HOME')
    base = Path(xdg) if xdg else Path.home() / '.config'
    return base / 'tdiff' / 'config.toml'

def load_config(override, error):
    """Load status/vault config from TOML, bootstrapping a default file on first run.
    Populates the module-level STATUS_PRIORITY, DEFAULT_IGNORE, PROJECT_STATUSES,
    DAILY_FOLDER, WEEKLY_FOLDER globals. `error` is a callable(msg) for fatal errors."""
    global STATUS_PRIORITY, DEFAULT_IGNORE, PROJECT_STATUSES, DAILY_FOLDER, WEEKLY_FOLDER
    path = config_path(override)
    if not path.exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(DEFAULT_CONFIG_TOML)
        print(f"tdiff: created default config at {path}", file=sys.stderr)
    try:
        with path.open('rb') as f:
            data = tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        error(f"invalid config at {path}: {e}")
        return

    statuses = data.get('statuses', {})
    STATUS_PRIORITY  = {c: v.get('priority', 0) for c, v in statuses.items()}
    DEFAULT_IGNORE   = {c for c, v in statuses.items() if v.get('ignore')}
    PROJECT_STATUSES = {c for c, v in statuses.items() if v.get('project')}

    vault = data.get('vault', {})
    DAILY_FOLDER  = vault.get('daily_folder', '')
    WEEKLY_FOLDER = vault.get('weekly_folder', '')

WIKILINK_RE = re.compile(r'\[\[([^\[\]]+)\]\]')

def _strip_wiki_path(m):
    inner = m.group(1)
    if '|' in inner:
        target, alias = inner.split('|', 1)
        return f'[[{target.rsplit("/", 1)[-1]}|{alias}]]'
    return f'[[{inner.rsplit("/", 1)[-1]}]]'

def normalize_wikilinks(s):
    return WIKILINK_RE.sub(_strip_wiki_path, s)

_PUNCT = ',.;:!?-—…'

def _tokens(s):
    out = []
    for t in s.split():
        t = t.lower().strip(_PUNCT)
        if t:
            out.append(t)
    return out

# ── Reading the vault ─────────────────────────────────────────────────────────

class ObsidianError(Exception):
    """The obsidian CLI could not be run, or reported an error we can't interpret.
    `retry` is False for permanent failures (no binary), True for ones observed to be
    transient. `stalled` marks the timeout case, which is worth telling the user about
    because it's the only failure they feel as a pause."""
    def __init__(self, msg, retry=True, stalled=False):
        super().__init__(msg)
        self.retry = retry
        self.stalled = stalled

# A note that simply doesn't exist is normal (a day with no note, a week with no
# planning file) — obsidian reports it on stdout with exit status 0.
_MISSING_FILE_RE = re.compile(r'^Error: File "[^"]*" not found\.$')
_TASK_RE         = re.compile(r'^- (\[.\]) (.+)$')
_NEW_PREFIX_RE   = re.compile(r'^\(new\)\s*', re.IGNORECASE)

def _env_int(name, default):
    try:
        return max(1, int(os.environ[name]))
    except (KeyError, ValueError):
        return default

# Concurrency is a small win (4 and 8 workers measure the same), so keep it low —
# the obsidian CLI talks to a single running app. TDIFF_WORKERS=1 forces serial reads.
FETCH_WORKERS = _env_int('TDIFF_WORKERS', 4)

# Roughly one obsidian call in a few hundred wedges and never returns, at the same
# rate whether we read serially or concurrently. The wedge is per-invocation — the app
# keeps answering everything else — so a short deadline plus a fresh call is the cure.
# A healthy call takes ~10ms (20ms worst of 320 measured), so 1s is ~100x headroom and
# keeps a stall inside the second this tool should always finish in. A merely slow call
# is not lost by a tight deadline: the retry catches it.
OBSIDIAN_TIMEOUT  = _env_int('TDIFF_TIMEOUT', 1)   # seconds per call
OBSIDIAN_ATTEMPTS = 3
SLOW_NOTICE_AFTER = 2.5     # seconds before telling the user we're waiting, not hung
DEBUG = bool(os.environ.get('TDIFF_DEBUG'))

_lines_cache = {}

def die(msg):
    """Report a fatal error and leave immediately. os._exit() because a wedged
    obsidian call can leave a pool thread blocked, and a normal exit would hang
    joining it."""
    sys.stdout.flush()
    sys.stderr.write(f"tdiff: {msg}\n")
    sys.stderr.flush()
    os._exit(2)

def _on_uncaught(exc_type, exc, tb):
    """Ctrl-C should leave at once — without a traceback, and without waiting on
    reader threads that may be stuck on a slow obsidian call."""
    if issubclass(exc_type, KeyboardInterrupt):
        sys.stdout.flush()
        sys.stderr.write('\ntdiff: interrupted\n')
        sys.stderr.flush()
        os._exit(130)
    sys.__excepthook__(exc_type, exc, tb)

sys.excepthook = _on_uncaught

def _run_obsidian(file_path):
    """Return the raw task lines for one vault file, retrying a failure that might be
    transient. Raises ObsidianError once the attempts are spent."""
    for attempt in range(1, OBSIDIAN_ATTEMPTS + 1):
        try:
            return _obsidian_once(file_path)
        except ObsidianError as e:
            if not e.retry or attempt == OBSIDIAN_ATTEMPTS:
                raise
            if e.stalled:
                sys.stderr.write(f"tdiff: obsidian stalled on {file_path}, retrying\n")

def _obsidian_once(file_path):
    """One `obsidian tasks` call. Raises ObsidianError if the CLI is missing or its
    output isn't something we can trust."""
    argv = ['obsidian', 'tasks', f'file={file_path}']
    started = time.monotonic()
    try:
        # stdin is closed: this is never an interactive call, and a CLI that decided
        # to read from the terminal would block every reader thread behind it.
        result = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True,
                                text=True, timeout=OBSIDIAN_TIMEOUT)
    except FileNotFoundError:
        raise ObsidianError(
            "the 'obsidian' CLI was not found on PATH — tdiff reads the vault through it",
            retry=False,
        )
    except subprocess.TimeoutExpired:
        raise ObsidianError(
            f"'obsidian tasks file={file_path}' produced nothing within "
            f"{OBSIDIAN_TIMEOUT}s on {OBSIDIAN_ATTEMPTS} attempts — is Obsidian running "
            f"with the vault open? (TDIFF_TIMEOUT=N raises the limit)",
            stalled=True,
        )
    except OSError as e:
        raise ObsidianError(f"could not run 'obsidian': {e}")

    if DEBUG:
        sys.stderr.write(f"tdiff: {time.monotonic() - started:6.3f}s  {file_path}\n")

    out, err = result.stdout, result.stderr.strip()
    if result.returncode != 0:
        detail = err or out.strip()
        first = detail.splitlines()[0] if detail else '(no output)'
        raise ObsidianError(f"'obsidian tasks file={file_path}' exited {result.returncode}: {first}")

    lines = out.splitlines()
    if len(lines) == 1 and _MISSING_FILE_RE.match(lines[0].strip()):
        return []
    for line in lines:
        if line.startswith('Error:'):
            raise ObsidianError(f"obsidian could not read {file_path!r}: {line}")
    if not out.strip() and err:
        raise ObsidianError(f"obsidian returned no tasks for {file_path!r}: {err.splitlines()[0]}")
    return lines

def obsidian_lines(file_path):
    """Memoized task lines for one vault file."""
    if file_path not in _lines_cache:
        try:
            _lines_cache[file_path] = _run_obsidian(file_path)
        except ObsidianError as e:
            die(str(e))
    return _lines_cache[file_path]

def prefetch(paths):
    """Warm the line cache for several vault files at once. Each obsidian call is
    mostly waiting on the app, so overlapping them is a win for week modes."""
    todo = [p for p in dict.fromkeys(paths) if p not in _lines_cache]
    if not todo:
        return
    notice = threading.Timer(SLOW_NOTICE_AFTER, sys.stderr.write,
                             (f"tdiff: waiting on obsidian ({len(todo)} files)…\n",))
    notice.daemon = True
    notice.start()
    try:
        if FETCH_WORKERS < 2 or len(todo) < 2:
            for p in todo:
                obsidian_lines(p)
            return
        with ThreadPoolExecutor(max_workers=min(FETCH_WORKERS, len(todo))) as ex:
            futures = [(p, ex.submit(_run_obsidian, p)) for p in todo]
        try:
            for p, fut in futures:
                _lines_cache[p] = fut.result()
        except ObsidianError as e:
            die(str(e))
    finally:
        notice.cancel()

def _parse_obsidian(file_path, day_index):
    """Yield (base, status, day_index) records from one obsidian file path."""
    for line in obsidian_lines(file_path):
        if '#routine' in line:
            continue
        m = _TASK_RE.match(line.rstrip())
        if not m:
            continue
        status, full_name = m.group(1), m.group(2)
        full_name = full_name.replace('\\[', '[').replace('\\]', ']')
        full_name = normalize_wikilinks(full_name)
        base = strip_section_suffix(full_name)
        base = _NEW_PREFIX_RE.sub('', base)
        yield base, status, day_index

def daily_path(d):
    return f'{DAILY_FOLDER}/{d}' if DAILY_FOLDER else d

def weekly_path(week_label):
    return f'{WEEKLY_FOLDER}/{week_label}' if WEEKLY_FOLDER else week_label

def cluster_records(records):
    """Cluster records that name the same logical task, using union-find. Two bases
    are the same task when their token sets are equal, or when one is a strict subset
    of the other and both start with the same token. Returns a list of clusters (each
    a list of records) in first-seen order of their root base."""
    bases_in_order, seen = [], set()
    for base, _, _ in records:
        if base not in seen:
            seen.add(base)
            bases_in_order.append(base)

    parent = {b: b for b in bases_in_order}
    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x
    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[ra] = rb

    # Bucketing on the two merge keys gives the same clusters as an all-pairs scan
    # without tokenizing (or comparing) every pair. Tokenless bases could only merge
    # by exact string equality, which distinct bases never satisfy — so skip them.
    by_tokens, by_first = {}, {}
    for b in bases_in_order:
        toks = _tokens(b)
        if not toks:
            continue
        key = frozenset(toks)
        by_tokens.setdefault(key, []).append(b)
        by_first.setdefault(toks[0], []).append((b, key))

    for group in by_tokens.values():
        for b in group[1:]:
            union(group[0], b)
    for group in by_first.values():
        for i, (a, sa) in enumerate(group):
            for b, sb in group[i + 1:]:
                if sa < sb or sb < sa:
                    union(a, b)

    by_root = {}
    for rec in records:
        by_root.setdefault(find(rec[0]), []).append(rec)

    clusters, emitted = [], set()
    for b in bases_in_order:
        r = find(b)
        if r in emitted:
            continue
        emitted.add(r)
        clusters.append(by_root[r])
    return clusters

def materialize(clusters):
    """Reduce each cluster to one (canonical_base, winning_status) pair."""
    tasks, order, occurrences = {}, [], {}
    for members in clusters:
        # Canonical: most recent day; tie-break by longest base.
        canonical = max(members, key=lambda r: (r[2], len(r[0])))[0]
        # Winning status: highest STATUS_PRIORITY; tie-break by latest day.
        winning = max(members, key=lambda r: (r[2], STATUS_PRIORITY.get(r[1][1], 0)))[1]
        order.append(canonical)
        tasks[canonical] = winning
        occurrences[canonical] = [s for _, s, _ in members]
    return tasks, order, occurrences

def week_span(d):
    """Return (sunday, saturday, label) for the US-format Sun-Sat week containing d."""
    if isinstance(d, str):
        d = date.fromisoformat(d)
    days_back = (d.weekday() + 1) % 7   # Mon=0..Sun=6 -> Sun=0
    sun = d - timedelta(days=days_back)
    sat = sun + timedelta(days=6)
    # The label's year is the *Saturday's*, not the Sunday's. Week 1 is the week
    # containing Jan 1, so a week straddling New Year belongs to the year it ends
    # in — which is what the vault's moment `gggg[-W]ww` filenames say. Anchoring
    # on the Sunday called Sun 2026-12-27 → Sat 2027-01-02 `2026-W53`, a file that
    # does not exist, and made the vault's real `2027-W01` unreachable by name.
    # Only the straddling week per year is affected; all others are unchanged.
    jan1 = date(sat.year, 1, 1)
    days_back = 0 if jan1.isoweekday() == 7 else jan1.isoweekday()
    week_num = ((sun - jan1).days + days_back) // 7 + 1
    return sun, sat, f"{sat.year}-W{week_num:02d}"

def week_entries(sunday, exclude=None, exclude_weekly_file=False):
    """(vault_path, day_index) pairs for a Sun-Sat week: the 7 daily notes plus the
    YYYY-W## planning file at day_index 0 (lowest dedup priority).
    `exclude` (ISO date string): skip that day. `exclude_weekly_file`: omit the weekly file."""
    entries = []
    for i in range(7):
        d = (sunday + timedelta(days=i)).isoformat()
        if d == exclude:
            continue
        entries.append((daily_path(d), i))
    if not exclude_weekly_file:
        _, _, week_label = week_span(sunday)
        entries.append((weekly_path(week_label), 0))
    return entries

def side_entries(side):
    """(vault_path, day_index) pairs backing one side of a comparison.
    side: ('day', date_str) | ('week', (sun, excl_day, excl_wf)) | ('weekly_file', label)"""
    kind, key = side
    if kind == 'week':
        sun, exclude_day, exclude_wf = key
        return week_entries(sun, exclude_day, exclude_wf)
    if kind == 'weekly_file':
        return [(weekly_path(key), 0)]
    return [(daily_path(key), 0)]

def side_records(entries):
    """Raw (base, status, day_index) records for one side, without materializing."""
    prefetch([p for p, _ in entries])
    return [rec for path, day_index in entries for rec in _parse_obsidian(path, day_index)]

def fetch_side(side):
    """Group one side's notes into a single virtual note: (tasks, order, occurrences)."""
    return materialize(cluster_records(side_records(side_entries(side))))

def _tokenset(s):
    return set(s.lower().split())

def jaccard(sa, sb):
    if not sa and not sb:
        return 1.0
    return len(sa & sb) / len(sa | sb)

def prefix_sim(a, b):
    matcher = difflib.SequenceMatcher(None, a.lower(), b.lower())
    blocks = matcher.get_matching_blocks()
    if not blocks:
        return 0.0
    first = blocks[0]
    if first.a != 0 or first.b != 0:
        return 0.0
    return (2 * first.size) / (len(a) + len(b))

def best_match(name, candidates):
    """Closest candidate above the similarity threshold, or None.
    `candidates` is a list of (name, tokenset) pairs; ties go to the earlier one."""
    na, la = _tokenset(name), len(name)
    first_char = name[:1].lower()
    best, best_score = None, 0
    for c, nc in candidates:
        score = jaccard(na, nc)
        # prefix_sim() is the expensive half (difflib) and can only change the
        # outcome if it beats both this pair's jaccard and the running best. Its
        # ceiling is 2*min(len)/(sum len), and it is 0 unless the first chars match.
        if c[:1].lower() == first_char:
            ceiling = 2 * min(la, len(c)) / (la + len(c))
            if ceiling > max(score, best_score):
                score = max(score, prefix_sim(name, c))
        if score > best_score:
            best, best_score = c, score
    if best and best_score >= JACCARD_THRESHOLD:
        return best
    return None

