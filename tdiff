#!/usr/bin/env python3
import sys, re, json, argparse
from datetime import date, datetime, timedelta
from pathlib import Path

# Everything tdiff and tcat both need lives in tnotes, one copy, imported rather than
# vendored. ~/.local/lib is not on sys.path and there is no install step: the module is
# symlinked there the same way both scripts are symlinked into ~/.local/bin. A missing
# symlink is worth a sentence rather than an ImportError traceback.
sys.path.insert(0, str(Path.home() / '.local' / 'lib'))
try:
    import tnotes as tn
except ImportError:
    sys.stderr.write("tdiff: cannot import tnotes — symlink it into "
                     f"{Path.home() / '.local' / 'lib' / 'tnotes.py'}\n")
    raise SystemExit(2)
tn.init('tdiff')

JACCARD_THRESHOLD = 0.7
PREFIX_THRESHOLD  = 0.7

# Set from --all once args are parsed; read by _parse_obsidian() at call time.
SHOW_ALL = False

# ── Reading the vault ─────────────────────────────────────────────────────────

# How each kind of note is read. The kwargs travel with the note in side_entries(),
# because what a note means depends on which side asked for it, not on its name.
#
# A daily note is read whole, whether it is a side of its own or one of seven folded
# into a week. It used to drop a section named "future" in the week case, on the
# reasoning that folding seven days together pulls deferred work in beside what
# actually happened. That reasoning was sound for one vault and wrong as a rule: it
# hardcoded both that such a section exists and what it means. A vault that spells it
# otherwise was unreachable, and one that wants it folded in could not say so.
# `[exclude] sections` says either.
DAY_MODE = {}

def weekly_mode(until=None, only_anchor=False):
    """Read kwargs for a YYYY-W## weekly note.

    There is nothing left to say about *which* sections to read: the note is read
    whole, like a daily one, and a vault that wants a section kept out names it in
    [exclude] sections. This used to pin the read to one heading and to a whitelist of
    day markers, both spelled into the source — so a plan parked under a heading this
    file had never heard of was unreachable however the config was written.

    What survives is the day ladder, and only for `until`: tasks allocated to a day
    *after* the anchor are dropped, because nothing allocated to Thursday is
    outstanding on Wednesday. Tasks under no marker at all are never dropped — most of
    a week being planned is unallocated, and an unallocated task has no day to be late
    for.

    **The anchor's own day is kept, and that is the one place the exclusive bound does
    not apply.** It used to be dropped, on the reading that a week derived from a date
    stops strictly *before* it. That rule is right about the daily notes — they run
    Sunday→anchor−1, so the anchor's own note stays on the B side and nothing is
    compared against itself — but it is wrong here, because the weekly note's
    allocation for today is not a copy of today's list. It is what today was *supposed*
    to be. Dropping it made every task the plan set for today read as `added` and
    silently hid the one thing `tdiff today` exists to catch: a task the plan assigned
    to today that never made it onto today's list, which shows as `deleted`.

    This was invisible until [days] worked. The old matcher took `**monday**` and not
    the wikilink form, so no day ever opened and the weekly note contributed its whole
    plan whatever the anchor — which looked correct for exactly the wrong reason.
    """
    if until is None:
        return {}
    idx = (date.fromisoformat(until).weekday() + 1) % 7
    if only_anchor:
        return {'only_days': (tn.WEEK_DAYS[idx],)}
    return {'skip_days': tn.WEEK_DAYS[idx + 1:]}

def _parse_obsidian(file_path, day_index, read_kwargs):
    """Yield (scope_key, scope_name, status, base, status_char, day_index) records.

    A project header — a task at indent 0 whose status is in [roles] project — opens a
    scope that the indented tasks under it belong to; any other indent-0 task closes it
    and belongs to the bare scope (`scope_key = None`). The header is context, never a
    row of its own, so it is not yielded.

    Grouping happens here, inside one note, so a header left open at the end of one
    note cannot adopt the indented tasks of the next. tcat's build_groups never faces
    that — it only ever sees a single note — but a tdiff week side concatenates eight.

    Scope keys are lowercased so [[Project Alpha]] and [[project alpha]] are one
    project; the display name is the first spelling seen.
    """
    scope_key = scope_name = scope_status = None
    for indent, status_char, name, _seq in tn.parse_note(
            tn.obsidian_lines(file_path),
            exclude=() if SHOW_ALL else tn.EXCLUDED_SECTIONS,
            exclude_tags=() if SHOW_ALL else tn.EXCLUDED_TAGS,
            day_patterns=tn.DAY_PATTERNS, **read_kwargs):
        base = name
        if indent == 0:
            if status_char in tn.PROJECT_STATUSES:
                scope_key, scope_name, scope_status = base.lower(), base, status_char
                continue
            scope_key = scope_name = scope_status = None
        # Re-bracket: parse_note yields the bare char, but tdiff stores statuses as
        # '[x]' and every consumer downstream indexes [1] for the char. Yielding the
        # bare form here fails silently rather than loudly.
        yield scope_key, scope_name, scope_status, base, f'[{status_char}]', day_index

def week_entries(sunday, anchor=None, want_dailies=True, want_weekly=True):
    """(vault_path, day_index, read_kwargs) triples for one Sun-Sat week.

    The week has exactly two sources and `want_dailies` / `want_weekly` pick which to
    read: the seven daily notes, and the YYYY-W## weekly note at day_index 0 — lowest
    dedup priority, so it loses every tie against a daily.

    `anchor` (ISO date) is the day the week was derived from, and bounds it *strictly
    before* that day — on both sources: the dailies stop at anchor-1, and the weekly
    note drops tasks allocated to that day or later. Two things fall out of the one
    bound. The anchor is the other side of the comparison, so it can never be compared
    against itself; and nothing dated after it can be outstanding as of it, which is
    what makes `tdiff wednesday` read "going into Wednesday" rather than "that week,
    Thursday and Friday included". A bare `today` looked right under the old
    anchor-only exclusion purely because tomorrow's note is usually empty.
    """
    entries = []
    if want_dailies:
        for i in range(7):
            d = (sunday + timedelta(days=i)).isoformat()
            if anchor is not None and d >= anchor:
                break
            entries.append((tn.daily_path(d), i, DAY_MODE))
    if want_weekly:
        _, _, week_label = tn.week_span(sunday)
        entries.append((tn.weekly_path(week_label), 0,
                        weekly_mode(anchor, only_anchor=not want_dailies)))
    return entries

def side_entries(side):
    """(vault_path, day_index, read_kwargs) triples backing one side of a comparison.
    side: ('day', date_str) | ('week', (sun, anchor, want_dailies, want_weekly))"""
    kind, key = side
    if kind == 'week':
        return week_entries(*key)
    return [(tn.daily_path(key), 0, DAY_MODE)]

def side_paths(side):
    """Just the vault paths one side reads, in order."""
    return [path for path, _, _ in side_entries(side)]

def fetch_side(side):
    """Group one side's notes into a single virtual note, scoped by project.

    Returns {scope_key: (display_name, header_status, tasks, order)}, scope keys in
    first-seen order. Dedup runs once per scope and the scopes never merge, exactly as
    in tcat: a task written both bare and under a project keeps a row in each, because
    the header is real context and a bare occurrence should not swallow a project's
    copy. The consequence to expect is that scoping only ever *adds* rows.
    """
    entries = side_entries(side)
    tn.prefetch([path for path, _, _ in entries])
    buckets, headers, order = {}, {}, []
    for path, day_index, kwargs in entries:
        for skey, sname, sstatus, base, status, di in _parse_obsidian(
                path, day_index, kwargs):
            if skey not in buckets:
                buckets[skey], headers[skey] = [], (sname, sstatus)
                order.append(skey)
            buckets[skey].append((base, status, di))
    scopes = {k: headers[k] + tn.materialize(tn.cluster_records(v))
              for k, v in buckets.items()}
    return scopes, order

def _tokenset(s):
    return set(s.lower().split())

def jaccard(sa, sb):
    if not sa and not sb:
        return 1.0
    overlap = len(sa & sb)
    return overlap / (len(sa) + len(sb) - overlap)

def prefix_sim(a, b):
    prefix_len = 0
    for ca, cb in zip(a.lower(), b.lower()):
        if ca != cb:
            break
        prefix_len += 1
    return (2 * prefix_len) / (len(a) + len(b))

def best_match(name, candidates):
    """Closest candidate above the similarity threshold, or None.
    `candidates` is a list of (name, tokenset) pairs; ties go to the earlier one."""
    na, la = _tokenset(name), len(name)
    first_char = name[:1].lower()
    best, best_score = None, 0
    for c, nc in candidates:
        # Neither metric can reach the threshold when the shorter side is too small.
        # Once a match exists, candidates that can only tie it cannot replace it.
        token_ceiling = (min(len(na), len(nc)) / max(len(na), len(nc))
                         if na or nc else 1.0)
        same_first = c[:1].lower() == first_char
        prefix_ceiling = (2 * min(la, len(c)) / (la + len(c))) if same_first else 0.0
        ceiling = max(token_ceiling, prefix_ceiling)
        if ceiling < JACCARD_THRESHOLD or ceiling <= best_score:
            continue

        score = jaccard(na, nc)
        # Prefix similarity can only change the outcome when its length-based ceiling
        # beats both this pair's Jaccard score and the running best.
        if same_first:
            if prefix_ceiling > max(score, best_score):
                score = max(score, prefix_sim(name, c))
        if score > best_score:
            best, best_score = c, score
    if best and best_score >= JACCARD_THRESHOLD:
        return best
    return None

# ── Argument parsing ──────────────────────────────────────────────────────────

parser = argparse.ArgumentParser(
    prog='tdiff',
    description='Compare tasks between two Obsidian notes, or between two weeks.',
    epilog=(
        'Dates accept YYYY-MM-DD, "today", "yesterday", "tomorrow", "0" (today), -N / +N '
        '(e.g. -1 for yesterday), a weekday name (monday..sunday, or mon..sun), which '
        'resolves to its most recent occurrence at or before today, or w## / w2026-W## '
        'for a Sun-Sat week (e.g. w20 = week 20 of the current year). '
        'A date names its daily note; a w## names a week. A week has two sources — its '
        'seven dailies and its YYYY-W## weekly note — and -D / -W read just one of them; '
        'naming neither reads both. Given one positional, it is compared against the week '
        'around it, minus itself: a date against the days before it, a w## against its '
        "own dailies."
    ),
)
parser.add_argument('date_a', help='first (older) date or week')
parser.add_argument('date_b', nargs='?', default=None,
                    help='second (newer) date or week; omit to compare date_a against '
                         'the week around it')
parser.add_argument('-T', '--types',      type=str, default=None,
                    help="show only rows of the given types (chars from 'dacs': "
                         "d=deleted, a=added, c=changed, s=same, e.g. 'dac'); "
                         "prefix '^' to invert (e.g. '^s'). Default: show all types, "
                         "ordered by [order].statuses.")
parser.add_argument('-I', '--ignore',     action='store_true',
                    help='hide settled tasks — any row whose displayed status is named by '
                         '[roles] settled (done, cancelled, overrun, postponed, advanced), '
                         'whichever side it came from. '
                         'Composes with -S, which wins for any status it names outright')
parser.add_argument('-S', '--status',     type=str, default=None,
                    help="show only rows whose effective status is in the given set "
                         "(concatenated chars, e.g. 'x-#'); prefix '^' to invert (e.g. '^x'). "
                         "Bare '-S -' looks like a flag to argparse; use -S=- or quote in a set ('x-')")
# -D and -W narrow a week to one of its two sources; omitting both reads the whole
# week, which is why naming both would be a second spelling of the default.
_week_flags = parser.add_mutually_exclusive_group()
_week_flags.add_argument('-D', '--dailies', action='store_true',
                    help="read only the week's seven daily notes, not its weekly note")
_week_flags.add_argument('-W', '--weekly', action='store_true',
                    help="read only the week's YYYY-W## weekly note, not its dailies")
parser.add_argument('--all',              action='store_true', dest='show_all',
                    help='ignore the whole [exclude] table, sections and tags '
                         'alike; fenced blocks are still skipped')
parser.add_argument('--json',             action='store_true',
                    help='emit a machine-readable JSON document instead of text '
                         '(implies --no-color; --no-summary does not apply)')
parser.add_argument('--no-color',         action='store_true', help='disable colored output')
parser.add_argument('--no-summary',       action='store_true', help='suppress the summary line')
parser.add_argument('--config',           type=str, default=None,
                    help='additional (merging) config layer, applied last; the layers below '
                         'it are ~/.config/obsidian-tasks/statuses.toml, '
                         '~/.config/tdiff/config.toml, then $TDIFF_CONFIG')

# argparse chokes on bare negative numbers like -1 before we can process them;
# intercept them and turn them into a safe token first.
raw = sys.argv[1:]
safe = [('__NEG__' + a[1:]) if re.fullmatch(r'-\d+', a) else a for a in raw]
args = parser.parse_args(safe)

SHOW_ALL = args.show_all
tn.load_config(args.config, parser.error)

# A week has two sources; -D and -W pick one, naming neither picks both. argparse
# makes them mutually exclusive, so this pair is the whole of what the flags mean.
WANT_DAILIES = not args.weekly
WANT_WEEKLY  = not args.dailies

def resolve_date(raw):
    """tn.resolve_date, with the error routed back to this parser. The module raises
    rather than reporting because the message belongs to the caller's argument parser,
    which is the one thing a shared module cannot own — and is exactly why this
    function used to sit outside tcat's vendored block and drift."""
    try:
        return tn.resolve_date(raw)
    except tn.DateError as e:
        parser.error(str(e))

raw_a = tn.restore(args.date_a)
raw_b = tn.restore(args.date_b) if args.date_b is not None else None
week_label_a = tn.resolve_week_label(raw_a)
week_label_b = tn.resolve_week_label(raw_b) if raw_b is not None else None

# side_a / side_b:
#   ('day', date_str) | ('week', (sunday, anchor, want_dailies, want_weekly))
side_a = side_b = None

def base_side(raw, week_label):
    """What a positional names on its own: a w## names its whole Sun-Sat week, read
    through whichever sources -D/-W left standing; anything else names a daily note.

    A date is never promoted to its week. -D/-W narrow a week that is already there,
    which is why `tdiff mon fri -D` is an error rather than a second way to spell
    `tdiff w33 w34 -D`."""
    if week_label:
        sun = tn._week_label_to_sunday(week_label)
        return ('week', (sun, None, WANT_DAILIES, WANT_WEEKLY))
    return ('day', resolve_date(raw))

if raw_b is not None:
    side_a = base_side(raw_a, week_label_a)
    side_b = base_side(raw_b, week_label_b)
    if side_a[0] == 'week' and side_b[0] == 'week' and side_a[1][0] == side_b[1][0]:
        parser.error("both positionals name the same Sun-Sat week; "
                     "comparing it against itself would be a no-op")
elif week_label_a:
    # One w##: its weekly note against its own dailies. The note is the anchor, so it
    # drops out of the week built around it — which leaves exactly the two sources,
    # one per side. The weekly note is what was written first, so it takes the A side.
    #
    # Both flags are rejected here rather than ignored: -D would remove the A side and
    # -W the B side, and either way the command already has a shorter spelling.
    if args.dailies or args.weekly:
        parser.error("a lone w## already compares the weekly note against that week's "
                     "dailies; -D/-W would leave one side empty")
    sun = tn._week_label_to_sunday(week_label_a)
    side_a = ('week', (sun, None, False, True))
    side_b = ('week', (sun, None, True, False))
else:
    # One date: the week around it against the date itself. The date is the anchor and
    # drops back out of that week, so it is never compared against itself.
    anchor = resolve_date(raw_a)
    sun, _, _ = tn.week_span(anchor)
    side_a = ('week', (sun, anchor, WANT_DAILIES, WANT_WEEKLY))
    side_b = ('day', anchor)

# -D/-W narrow a week. With two dates there is no week to narrow, and promoting them
# both would silently answer a different question than the one that was asked.
if (args.dailies or args.weekly) and 'week' not in (side_a[0], side_b[0]):
    parser.error("-D/-W need a week to narrow; name one with w## "
                 "(e.g. 'tdiff w33 w34 -D') or give a single date")

status_filter = None            # (set_of_chars, negate)
if args.status is not None:
    v = args.status
    negate = v.startswith('^')
    if negate:
        v = v[1:]
    chars = set(v)
    if not chars:
        parser.error("--status expects at least one status char (e.g. 'x-#' or '^x')")
    status_filter = (chars, negate)

def status_match(eff):
    if status_filter is None:
        return True
    chars, negate = status_filter
    return (eff not in chars) if negate else (eff in chars)

if args.ignore and not tn.SETTLED_STATUSES:
    tn.notice('-I: no [roles] settled in config — nothing to hide')

def suppressed(eff):
    """Whether a row is hidden by default, before -S and -T get their say.

    Two rules live here, both from the shared [roles] table: `hide` (never shown at
    all) and `settled` (shown unless -I). They are checked in one place because they
    compose with -S under one rule, borrowed from tcat's status_match():

        a positive -S wins outright for the statuses it names.

    So `-S '»'` shows postponed rows even though `hide` lists them, and `-I -S x`
    shows done rows rather than nothing. A negated -S only says what to drop, so both
    rules still apply to everything it doesn't name.

    -I asks about the row's *displayed* status and nothing else, so it hides settled
    work whichever side put it there — a task finished on B is as settled as one
    finished on A. It used to be restricted to types 0 and 3, on the theory that only
    those read their status off the A side; that left `++ [x]` and `~~ [/] → [x]`
    on screen, which is exactly the work -I exists to get rid of. Filtering on `eff`
    is also what -S does, so the three status filters now ask the same question.
    """
    if status_filter is not None:
        chars, negate = status_filter
        if not negate and eff in chars:
            return False
    if eff in tn.HIDDEN_STATUSES:
        return True
    return args.ignore and eff in tn.SETTLED_STATUSES

TYPE_CHARS = {'d': 0, 'a': 1, 'c': 2, 's': 3}

type_filter = None      # (set_of_type_ints, negate)
if args.types is not None:
    v = args.types
    negate = v.startswith('^')
    if negate:
        v = v[1:]
    if not v or any(ch not in TYPE_CHARS for ch in v):
        parser.error("--types expects chars from 'dacs' (e.g. 'dac' or '^s')")
    type_filter = ({TYPE_CHARS[ch] for ch in v}, negate)

def type_match(typ):
    if type_filter is None:
        return True
    types, negate = type_filter
    return (typ not in types) if negate else (typ in types)

def finish(code=0):
    """Exit, flushing notices first. --json and --no-summary both mean 'output with
    nothing around it', so neither gets them."""
    if not (args.json or args.no_summary):
        tn.flush_notices()
    sys.exit(code)

# ── Colors ────────────────────────────────────────────────────────────────────

use_color = not args.no_color and not args.json and sys.stdout.isatty()
RED    = '\033[31m' if use_color else ''
GREEN  = '\033[32m' if use_color else ''
YELLOW = '\033[33m' if use_color else ''
DIM    = '\033[2m'  if use_color else ''
RESET  = '\033[0m'  if use_color else ''

# ── JSON output ───────────────────────────────────────────────────────────────

def side_label(side):
    """Human-facing name for one side: the date, or the YYYY-W## of a week."""
    kind, key = side
    return tn.week_span(key[0])[2] if kind == 'week' else key

def side_json(side):
    """Describe one side of the comparison, including the vault files it read — which
    is where -D/-W's narrowing and the one-positional form's exclusion are observable,
    since neither shows up anywhere else in the output."""
    kind, key = side
    out = {'kind': kind, 'label': side_label(side)}
    if kind == 'week':
        sun, sat, _ = tn.week_span(key[0])
        out['start'], out['end'] = sun.isoformat(), sat.isoformat()
    out['files'] = side_paths(side)
    return out

def emit_json(doc):
    json.dump(doc, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write('\n')

# ── Diff ──────────────────────────────────────────────────────────────────────

# One batched read for both sides, so every vault call overlaps.
tn.prefetch([p for side in (side_a, side_b) for p in side_paths(side)])

a_scopes, a_order = fetch_side(side_a)
b_scopes, b_order = fetch_side(side_b)

# Types: 0=deleted, 1=added, 2=changed, 3=same
# Rows are (scope_key, name, type, row_dict); row_dict is both the JSON record and what
# render() turns into a text line, so the two output modes can't drift apart.
#   name        canonical task name (A's for deleted/changed, B's for added)
#   status      effective status char — B's for added/changed/same, A's for deleted
#   old_status  A's status char (changed rows only)
#   new_name    B's name (changed rows only, and only when the fuzzy match renamed it)
#   project     the project the row sits under; absent on a bare row
TYPE_NAMES = {0: 'deleted', 1: 'added', 2: 'changed', 3: 'same'}

# scope_key -> (display_name, header_status) for every project either side saw. B wins
# a clash, matching the effective-status rule rows follow: B is the later statement.
PROJECTS = {k: v[:2] for k, v in a_scopes.items() if k is not None}
PROJECTS.update({k: v[:2] for k, v in b_scopes.items() if k is not None})

def row(scope, typ, name, status, old_status=None, new_name=None):
    r = {'type': TYPE_NAMES[typ], 'name': name, 'status': status}
    if old_status is not None:
        r['old_status'] = old_status
    if new_name is not None:
        r['new_name'] = new_name
    if scope is not None:
        r['project'] = PROJECTS[scope][0]
    return (scope, name, typ, r)

def render(r, indent=''):
    st = f"[{r['status']}]"
    typ = r['type']
    if typ == 'same':
        return f"{DIM}{indent}== {st}  {r['name']}{RESET}"
    if typ == 'deleted':
        return f"{RED}{indent}-- {st}  {r['name']}{RESET}"
    if typ == 'added':
        return f"{GREEN}{indent}++ {st}  {r['name']}{RESET}"
    old = f"[{r['old_status']}]"
    if 'new_name' in r:
        return f"{YELLOW}{indent}~~ {old} {r['name']} → {st} {r['new_name']}{RESET}"
    return f"{YELLOW}{indent}~~ {old} → {st}  {r['name']}{RESET}"

def diff_scope(scope, a_tasks, a_order, b_tasks, b_order):
    """Diff one project's tasks against the other side's copy of that project.

    Scopes are diffed independently and fuzzy matching never crosses one, so a task
    that moved between projects reads as deleted there and added here rather than
    silently staying put. A scope only one side has yields all-deleted or all-added,
    which is how a project appearing or disappearing shows up at all.
    """
    rows = []
    a_names, b_names = set(a_tasks), set(b_tasks)
    used_a, used_b = set(), set()

    # Pass 1: exact name matches
    for name in a_names & b_names:
        used_a.add(name)
        used_b.add(name)
        if a_tasks[name] != b_tasks[name]:
            rows.append(row(scope, 2, name, b_tasks[name][1],
                            old_status=a_tasks[name][1]))
        else:
            rows.append(row(scope, 3, name, a_tasks[name][1]))

    # Pass 2: fuzzy match remaining
    remaining_a = [n for n in a_order if n not in used_a]
    remaining_b = [n for n in b_order if n not in used_b]
    # Candidates carry their token sets so pass 2 tokenizes each name once, not once
    # per comparison; matched entries are dropped instead of re-filtered every round.
    candidates = [(n, _tokenset(n)) for n in remaining_b]

    for a_name in remaining_a:
        match = best_match(a_name, candidates)
        if match:
            used_b.add(match)
            candidates = [pair for pair in candidates if pair[0] != match]
            rows.append(row(scope, 2, a_name, b_tasks[match][1],
                            old_status=a_tasks[a_name][1],
                            new_name=match if match != a_name else None))
        else:
            rows.append(row(scope, 0, a_name, a_tasks[a_name][1]))

    for b_name in remaining_b:
        if b_name not in used_b:
            rows.append(row(scope, 1, b_name, b_tasks[b_name][1]))
    return rows

output = []
for scope in a_order + [k for k in b_order if k not in a_scopes]:
    _, _, a_tasks, a_names_order = a_scopes.get(scope, (None, None, {}, []))
    _, _, b_tasks, b_names_order = b_scopes.get(scope, (None, None, {}, []))
    output += diff_scope(scope, a_tasks, a_names_order, b_tasks, b_names_order)

# Projects first, then the bare rows — so the rows that carry their own context lead and
# the familiar flat list follows. Projects are ordered by their *header* status and never
# by their children's: sorting a project by the statuses inside it would let one urgent
# task drag a whole project to the top.
#
# Rows inside a group go type, then status, then name. Type outranks status because the
# question a diff answers is what moved, not what state it is in — reading straight down
# the added block and then the deleted block is the point of the tool. Status orders
# within a type, which is where [order].statuses does its work.
TYPE_RANK = {1: 0, 0: 1, 2: 2, 3: 3}    # added, deleted, changed, same — the summary's order
output.sort(key=lambda x: (x[0] is None,
                           tn.display_rank(PROJECTS[x[0]][1]) if x[0] else 0,
                           PROJECTS[x[0]][0].lower() if x[0] else '',
                           TYPE_RANK[x[2]],
                           tn.display_rank(x[3]['status']),
                           x[1].lower()))

# ── Filter ────────────────────────────────────────────────────────────────────

counts = {0: 0, 1: 0, 2: 0, 3: 0}
kept = []
seen_statuses = set()
for scope, _, typ, r in output:
    eff = r['status']
    seen_statuses.add(eff)
    # Structural: a project status on an ordinary row is a nested header, not work.
    # A project's own header never reaches here — it is a scope, not a row.
    if eff in tn.PROJECT_STATUSES:
        continue
    if suppressed(eff):                # [roles] hide, and -I on any settled row
        continue
    if not status_match(eff):          # -S: show only matching effective statuses
        continue
    if not type_match(typ):            # -T: show only matching row types
        continue
    counts[typ] += 1
    kept.append((scope, r))

tn.report_unlisted(seen_statuses)

# ── Output ────────────────────────────────────────────────────────────────────

if args.json:
    emit_json({
        'mode': 'diff',
        'a': side_json(side_a),
        'b': side_json(side_b),
        # Flat, with the project named on each row rather than nested children: the
        # filters and the summary then need no shape of their own, and grouping stays
        # a rendering concern. tcat's nested envelope had one consumer, -E, which is
        # gone.
        'rows': [r for _, r in kept],
        'summary': {
            'added':   counts[1],
            'deleted': counts[0],
            'changed': counts[2],
            'same':    counts[3],
            'total':   sum(counts.values()),
        },
    })
    finish()

# A header prints only when a row under it survived the filters — the sort has already
# put every project's rows together, so tracking the last one seen is enough.
last_scope = ...
for scope, r in kept:
    if scope != last_scope:
        if scope is not None:
            name, status = PROJECTS[scope]
            # Uncoloured on purpose: the diff type owns the row colours beneath it, and
            # a header dimmed to match nothing read as less structural than it is.
            print(f"[{status}] {name}")
        last_scope = scope
    print(render(r, indent='   ' if scope is not None else ''))

if not args.no_summary:
    total = sum(counts.values())
    parts = [
        f"{GREEN}{counts[1]} added{RESET}",
        f"{RED}{counts[0]} deleted{RESET}",
        f"{YELLOW}{counts[2]} changed{RESET}",
        f"{DIM}{counts[3]} same{RESET}",
        f"{total} total",
    ]
    projects = len({s for s, _ in kept if s is not None})
    if projects:
        parts.insert(-1, f"{projects} project" + ('' if projects == 1 else 's'))
    print('  ' + f"  {DIM}·{RESET}  ".join(parts))

finish()
