#!/usr/bin/env python3
import sys, re, os, json, time, threading, subprocess, argparse, tomllib
from concurrent.futures import ThreadPoolExecutor
from datetime import date, datetime, timedelta
from pathlib import Path

JACCARD_THRESHOLD = 0.7
PREFIX_THRESHOLD  = 0.7

_SEP_RE = re.compile(r' [-–—] ')  # hyphen, en-dash, em-dash

def strip_section_suffix(s):
    """Remove trailing ' – ...' only when the dash is outside of [...] brackets."""
    depth = 0
    for i, c in enumerate(s):
        if c == '[':
            depth += 1
        elif c == ']':
            depth = max(0, depth - 1)
        elif depth == 0 and c == ' ' and _SEP_RE.match(s, i):
            return s[:i].strip()
    return s.strip()

# Populated by load_config() once args are parsed. Placeholder empty values here
# so nothing explodes if referenced before load_config() runs.
STATUS_PRIORITY  = {}
DISPLAY_ORDER    = {}
SETTLED_STATUSES = set()
HIDDEN_STATUSES  = set()
PROJECT_STATUSES = set()
DAILY_FOLDER  = ''
WEEKLY_FOLDER = ''
CONFIG_FOUND  = False

# Set from --routines once args are parsed; read by _parse_obsidian() at call time.
INCLUDE_ROUTINES = False

# Complaints worth making but not worth interrupting for. Collected during the run
# and flushed to stderr at the end by flush_notices(), so they never interleave with
# the rows on stdout. Suppressed under --json and --no-summary, both of which mean
# "output with nothing around it".
NOTICES = []

def notice(msg):
    NOTICES.append(msg)

def _merge(base, overlay):
    """Recursive dict merge; the overlay wins.

    Lists replace wholesale rather than concatenating: an overlay that names a
    partial [dedup].priority means exactly those tiers, not an insertion into a
    lower layer's list.
    """
    for k, v in overlay.items():
        if isinstance(v, dict) and isinstance(base.get(k), dict):
            _merge(base[k], v)
        else:
            base[k] = v

def _xdg_base():
    xdg = os.environ.get('XDG_CONFIG_HOME')
    return Path(xdg) if xdg else Path.home() / '.config'

def config_paths(override):
    """Every config source, lowest precedence first.

    The status table describes the vault's notation, not this tool, so its home is
    obsidian-tasks/ — a directory neither tdiff nor tcat owns, which is what lets the
    two share one table without either depending on the other being installed. tdiff's
    own directory is an optional overlay for tdiff-only settings.

    Each source *merges* over the ones below it, including $TDIFF_CONFIG and --config.
    A partial file must never erase what a lower layer set: --config used to be a
    wholesale replacement, so pointing it at a file with no `statuses` table silently
    zeroed every priority and disabled both -I and the project exclusion.
    """
    base = _xdg_base()
    paths = [base / 'obsidian-tasks' / 'statuses.toml',
             base / 'tdiff' / 'config.toml']
    env = os.environ.get('TDIFF_CONFIG')
    if env:
        paths.append(Path(env))
    if override:
        paths.append(Path(override))
    return paths

def load_config(override, error):
    """Merge every config layer and populate the module-level globals.

    Never bootstraps a file. Unlike tcat, tdiff cannot run usefully with no config at
    all — an empty PROJECT_STATUSES leaks project headers into every diff — so no
    layers at all is a hard error. A layer that exists but omits a section degrades
    with a notice instead.

    [theme.*] is read by tcat and deliberately ignored here: in tdiff the diff type
    owns the row colour, so a status colour would have nothing to paint.
    """
    global STATUS_PRIORITY, DISPLAY_ORDER, SETTLED_STATUSES, HIDDEN_STATUSES
    global PROJECT_STATUSES, DAILY_FOLDER, WEEKLY_FOLDER, CONFIG_FOUND

    merged = {}
    for path in config_paths(override):
        if not path.exists():
            continue
        try:
            with path.open('rb') as f:
                data = tomllib.load(f)
        except tomllib.TOMLDecodeError as e:
            error(f'invalid config at {path}: {e}')
            return
        CONFIG_FOUND = True
        _merge(merged, data)

    if not CONFIG_FOUND:
        error('no status config found — install statuses.example.toml to '
              f'{_xdg_base() / "obsidian-tasks" / "statuses.toml"}')
        return

    # Tiers, highest precedence first; the inner list is how ties get expressed.
    # tcat's [order].statuses is a flat list and cannot express them — and means the
    # opposite anyway (it sorts `x` last for display; here `x` ranks highest for
    # dedup), which is why the two keys stay separate rather than being merged.
    tiers = merged.get('dedup', {}).get('priority', [])
    STATUS_PRIORITY = {c: len(tiers) - i for i, tier in enumerate(tiers) for c in tier}
    if not STATUS_PRIORITY:
        notice('no [dedup] priority in config — dedup will pick an arbitrary status '
               'when a task appears more than once')

    # Display rank, and the one place tdiff and tcat now agree on [order]. Rank is
    # position in the list, so `x` sorts last; see display_rank() for what an unlisted
    # status does. This is the *opposite* end from [dedup] above and stays a separate
    # key for that reason: a row that dedup picked `x` for still prints at the bottom.
    seq = merged.get('order', {}).get('statuses', [])
    DISPLAY_ORDER = {c: i for i, c in enumerate(seq)}
    if not DISPLAY_ORDER:
        notice('no [order] statuses in config — rows will sort by name alone')

    roles = merged.get('roles', {})
    PROJECT_STATUSES = set(roles.get('project', []))
    SETTLED_STATUSES = set(roles.get('settled', []))
    HIDDEN_STATUSES  = set(roles.get('hide', []))
    if not PROJECT_STATUSES:
        notice('no [roles] project in config — project rows will not be excluded')

    vault = merged.get('vault', {})
    DAILY_FOLDER  = vault.get('daily_folder', '')
    WEEKLY_FOLDER = vault.get('weekly_folder', '')

UNRANKED = 10 ** 6      # tcat's sentinel, same value, so the two sort alike

def display_rank(ch):
    """Sort rank for a status char, from [order].statuses.

    A status the table does not list ranks last as a block — alphabetical within it,
    since the name is the next sort key — which is what the shipped statuses.toml
    promises and what tcat does with the same list. report_unlisted() names them.
    """
    return DISPLAY_ORDER.get(ch, UNRANKED)

def flush_notices():
    for m in NOTICES:
        print(f'tdiff: {m}', file=sys.stderr)

WIKILINK_RE = re.compile(r'\[\[([^\[\]]+)\]\]')

# A wikilink keeps its brackets and loses only its folder path, so `[[a/b|c]]` reads
# as `[[b|c]]`. This is what clean_text runs, and what tcat's tools/check-core-sync.sh
# lists in FUNCS.
def _strip_wiki_path(m):
    inner = m.group(1)
    if '|' in inner:
        target, alias = inner.split('|', 1)
        return f'[[{target.rsplit("/", 1)[-1]}|{alias}]]'
    return f'[[{inner.rsplit("/", 1)[-1]}]]'

def normalize_wikilinks(s):
    return WIKILINK_RE.sub(_strip_wiki_path, s)

_PUNCT = ',.;:!?-—…'

def _tokens(s):
    out = []
    for t in s.split():
        t = t.lower().strip(_PUNCT)
        if t:
            out.append(t)
    return out

# ── Parsing a note ────────────────────────────────────────────────────────────
#
# Vendored verbatim into tcat, which checks it with tools/check-core-sync.sh. Both
# tools read raw markdown through `obsidian read` and parse it here, so a task has
# one name and one shape no matter which tool asked. Any change lands in both.

TASK_RE = re.compile(r'^(\s*)- (\[.\]) (.+)$')
H2_RE   = re.compile(r'^##\s+\*(\w+)\*')
H3_RE   = re.compile(r'^###\s+\*(\w+)\*')
MARK_RE = re.compile(r'^\*{2,3}([a-z]+)\*{2,3}\s*$')
MDLINK_RE = re.compile(r'\[([^\[\]]+)\]\([^()]*\)')

# The weekly day ladder. A whitelist, never a blacklist — the weekly template
# gains sections over time, and this is what keeps Ratio's **rationes** lines and
# Mensis's prospect checkboxes out of every day.
#
# WEEK_DAYS is the ladder's day span on its own: -A asks for all seven at once,
# and deriving LADDER from it keeps the two from drifting apart.
WEEK_DAYS = ('sunday', 'monday', 'tuesday', 'wednesday',
             'thursday', 'friday', 'saturday')
LADDER = ('promissum',) + WEEK_DAYS + ('future',)

def clean_text(s):
    """Un-escape Obsidian's bracket escapes, drop a trailing ' – ...' section suffix,
    then shorten wikilink paths and reduce markdown links to their display text.

    **The order is the whole point, and it diverges from tcat.** `strip_section_suffix`
    only skips a dash it can see is inside brackets, so it has to run while the
    brackets are still there. tcat reduces links first, which leaves
    `[[marc randolph on building netflix – tim ferriss (496)]]` looking like prose with
    a section suffix and truncates it at the dash — 18 of 455 names in this vault, some
    down to a third of their length. Un-escaping stays first either way, or `\\[\\[foo]]`
    never registers as bracket depth at all.

    Wikilinks keep their brackets (`normalize_wikilinks` only shortens the path), which
    is the second divergence: tdiff has always displayed `complete [[2026-W28]]`, and a
    name is a name whether or not the vault happened to link it. Markdown links do get
    reduced — that part is new, and without it a name carries a full URL.
    """
    s = s.replace('\\[', '[').replace('\\]', ']')
    s = strip_section_suffix(s)
    s = normalize_wikilinks(s)
    return MDLINK_RE.sub(lambda m: m.group(1), s)

def parse_note(lines, region=None, day=None, routines=False, skip_future=False):
    """Yield (indent, status_char, name, seq) for tasks in a note.

    Fence-agnostic by design: ``` lines are ignored, never toggled. The weekly
    note's whole Fixa section is itself fenced, so toggling desynchronises. Every
    `base`/`dataviewjs` block lives under ## *Recensio*, ahead of ### *Actio*.

    region/day: when both are given, only tasks under that ### heading and that
    ladder marker are yielded (weekly mode). `day` takes one marker name or a
    tuple of them — WEEK_DAYS folds the whole week into one pass, which is what
    -A -P wants. When neither is given, every task in the note is yielded (daily
    mode).

    skip_future: drop tasks sitting under a **future** marker. Only -A passes it.
    A daily note's future bucket is fair to show for that one day, but aggregating
    a week would fold deferred work in alongside what actually happened — and a
    pre-split Sunday's bucket holds a whole week of it.
    """
    days = (day,) if isinstance(day, str) else day
    cur_region = cur_day = None
    seq = 0
    for line in lines:
        if H2_RE.match(line):
            cur_region = cur_day = None
            continue
        m = H3_RE.match(line)
        if m:
            cur_region = m.group(1).lower()
            cur_day = None
            continue
        m = MARK_RE.match(line)
        if m and m.group(1) in LADDER:
            # Once inside **future**, stay there: a future fence may carry its own
            # **sunday**/**other** markers that must not re-enter the ladder.
            if cur_day != 'future':
                cur_day = m.group(1)
            continue
        m = TASK_RE.match(line)
        if not m:
            continue
        if not routines and '#routine' in line:
            continue
        if skip_future and cur_day == 'future':
            continue
        if region is not None and (cur_region != region or cur_day not in days):
            continue
        seq += 1
        yield len(m.group(1)), m.group(2)[1], clean_text(m.group(3)), seq

# ── Reading the vault ─────────────────────────────────────────────────────────

class ObsidianError(Exception):
    """The obsidian CLI could not be run, or reported an error we can't interpret.
    `retry` is False for permanent failures (no binary), True for ones observed to be
    transient. `stalled` marks the timeout case, which is worth telling the user about
    because it's the only failure they feel as a pause."""
    def __init__(self, msg, retry=True, stalled=False):
        super().__init__(msg)
        self.retry = retry
        self.stalled = stalled

# A note that simply doesn't exist is normal (a day with no note, a week with no
# planning note) — obsidian reports it on stdout with exit status 0.
_MISSING_FILE_RE = re.compile(r'^Error: File "[^"]*" not found\.$')
_NEW_PREFIX_RE   = re.compile(r'^\(new\)\s*', re.IGNORECASE)

def _env_int(name, default):
    try:
        return max(1, int(os.environ[name]))
    except (KeyError, ValueError):
        return default

# Concurrency is a small win (4 and 8 workers measure the same), so keep it low —
# the obsidian CLI talks to a single running app. TDIFF_WORKERS=1 forces serial reads.
FETCH_WORKERS = _env_int('TDIFF_WORKERS', 4)

# Roughly one obsidian call in a few hundred wedges and never returns, at the same
# rate whether we read serially or concurrently. The wedge is per-invocation — the app
# keeps answering everything else — so a short deadline plus a fresh call is the cure.
# A healthy call takes ~10ms (20ms worst of 320 measured), so 1s is ~100x headroom and
# keeps a stall inside the second this tool should always finish in. A merely slow call
# is not lost by a tight deadline: the retry catches it.
OBSIDIAN_TIMEOUT  = _env_int('TDIFF_TIMEOUT', 1)   # seconds per call
OBSIDIAN_ATTEMPTS = 3
SLOW_NOTICE_AFTER = 2.5     # seconds before telling the user we're waiting, not hung
DEBUG = bool(os.environ.get('TDIFF_DEBUG'))

_lines_cache = {}

def die(msg):
    """Report a fatal error and leave immediately. os._exit() because a wedged
    obsidian call can leave a pool thread blocked, and a normal exit would hang
    joining it."""
    sys.stdout.flush()
    sys.stderr.write(f"tdiff: {msg}\n")
    sys.stderr.flush()
    os._exit(2)

def _on_uncaught(exc_type, exc, tb):
    """Ctrl-C should leave at once — without a traceback, and without waiting on
    reader threads that may be stuck on a slow obsidian call."""
    if issubclass(exc_type, KeyboardInterrupt):
        sys.stdout.flush()
        sys.stderr.write('\ntdiff: interrupted\n')
        sys.stderr.flush()
        os._exit(130)
    sys.__excepthook__(exc_type, exc, tb)

sys.excepthook = _on_uncaught

def _run_obsidian(file_path):
    """Return the raw markdown lines of one vault file, retrying a failure that might
    be transient. Raises ObsidianError once the attempts are spent."""
    for attempt in range(1, OBSIDIAN_ATTEMPTS + 1):
        try:
            return _obsidian_once(file_path)
        except ObsidianError as e:
            if not e.retry or attempt == OBSIDIAN_ATTEMPTS:
                raise
            if e.stalled:
                sys.stderr.write(f"tdiff: obsidian stalled on {file_path}, retrying\n")

def _obsidian_once(file_path):
    """One `obsidian read` call. Raises ObsidianError if the CLI is missing or its
    output isn't something we can trust.

    `read` rather than `tasks`: the flat task list `tasks` returns has already
    thrown away the headings, and the ladder markers under ### *Actio* are the only
    thing that says which of a weekly note's tasks are the week's plan. tcat has
    always read raw markdown for that reason; this is the seam where the two tools
    stopped disagreeing about what a note contains."""
    argv = ['obsidian', 'read', f'file={file_path}']
    started = time.monotonic()
    try:
        # stdin is closed: this is never an interactive call, and a CLI that decided
        # to read from the terminal would block every reader thread behind it.
        result = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True,
                                text=True, timeout=OBSIDIAN_TIMEOUT)
    except FileNotFoundError:
        raise ObsidianError(
            "the 'obsidian' CLI was not found on PATH — tdiff reads the vault through it",
            retry=False,
        )
    except subprocess.TimeoutExpired:
        raise ObsidianError(
            f"'obsidian read file={file_path}' produced nothing within "
            f"{OBSIDIAN_TIMEOUT}s on {OBSIDIAN_ATTEMPTS} attempts — is Obsidian running "
            f"with the vault open? (TDIFF_TIMEOUT=N raises the limit)",
            stalled=True,
        )
    except OSError as e:
        raise ObsidianError(f"could not run 'obsidian': {e}")

    if DEBUG:
        sys.stderr.write(f"tdiff: {time.monotonic() - started:6.3f}s  {file_path}\n")

    out, err = result.stdout, result.stderr.strip()
    if result.returncode != 0:
        detail = err or out.strip()
        first = detail.splitlines()[0] if detail else '(no output)'
        raise ObsidianError(f"'obsidian read file={file_path}' exited {result.returncode}: {first}")

    lines = out.splitlines()
    if not lines:
        # An empty note is a legitimately empty side, the same as a missing one.
        return []
    # Only the *first* line can be an error report. Scanning them all was safe while
    # this read a task list; on raw markdown a note that happens to open a line with
    # "Error:" would be misread as a failed read.
    first = lines[0].strip()
    if _MISSING_FILE_RE.match(first):
        return []
    if first.startswith('Error:'):
        raise ObsidianError(f"obsidian could not read {file_path!r}: {first}")
    if not out.strip() and err:
        raise ObsidianError(f"obsidian returned nothing for {file_path!r}: {err.splitlines()[0]}")
    return lines

def obsidian_lines(file_path):
    """Memoized markdown lines for one vault file."""
    if file_path not in _lines_cache:
        try:
            _lines_cache[file_path] = _run_obsidian(file_path)
        except ObsidianError as e:
            die(str(e))
    return _lines_cache[file_path]

def prefetch(paths):
    """Warm the line cache for several vault files at once. Each obsidian call is
    mostly waiting on the app, so overlapping them is a win for week modes.

    `read` returns a whole note where `tasks` returned a handful of lines, so each
    payload is larger — but the call count is unchanged, and the wait was always
    the round trip rather than the bytes."""
    todo = [p for p in dict.fromkeys(paths) if p not in _lines_cache]
    if not todo:
        return
    # Named slow_timer, not notice: notice() is the deferred-message function, and a
    # local of that name here would shadow it for the whole body.
    slow_timer = threading.Timer(SLOW_NOTICE_AFTER, sys.stderr.write,
                                 (f"tdiff: waiting on obsidian ({len(todo)} files)…\n",))
    slow_timer.daemon = True
    slow_timer.start()
    try:
        if FETCH_WORKERS < 2 or len(todo) < 2:
            for p in todo:
                obsidian_lines(p)
            return
        # Both branches go through obsidian_lines() so the vault read has exactly one
        # seam. Submitting _run_obsidian directly used to leave the memo wrapper
        # bypassed on the concurrent path — a second entry point that anything hooking
        # the read would silently miss.
        with ThreadPoolExecutor(max_workers=min(FETCH_WORKERS, len(todo))) as ex:
            for p in todo:
                ex.submit(obsidian_lines, p)
    finally:
        slow_timer.cancel()

# How each kind of note is read. The kwargs travel with the note in side_entries(),
# because what a note means depends on which side asked for it, not on its name.
#
# A bare day side reads the whole daily note, future bucket included — it is that one
# day's own list, and deferring something is part of the day. The same note inside a
# week aggregation drops **future**, because folding seven days together would
# otherwise pull deferred work in beside what actually happened, and a pre-split
# Sunday's bucket holds a whole week of it.
DAY_MODE      = {}
WEEK_DAY_MODE = {'skip_future': True}

def weekly_mode(until=None):
    """Read kwargs for a YYYY-W## weekly note: the ### *Actio* section — the week's
    plan. The rest of the note (Impressio, Relatio, Cultus, Fixa) is structure and
    reference, not work assigned to this week, and used to leak into every week diff.

    `None` leads the day whitelist on purpose, and is the one divergence from tcat's
    -A -P. Actio's seven **weekday** markers are an *optional* second pass: a week is
    planned by listing tasks under the heading, and only some of them ever get
    allocated to a named day. On an organised week (W30, W32) every task carries a
    marker and the `None` entry matches nothing; on a week still being drafted (W31,
    W33) *everything* sits unallocated, and asking for WEEK_DAYS alone would report an
    empty plan against a section holding dozens of tasks. Reading the unallocated ones
    is what lets tdiff see a week you are still writing.

    `until` (ISO date) stops the whitelist strictly before that day's marker, so a
    week derived from a date anchor covers only what was due ahead of it. Nothing
    allocated to Thursday is outstanding on Wednesday.

    **future** is excluded either way — it is the deferral bucket, not this week — and
    the whitelist does that on its own, since 'future' is simply not in the tuple.
    """
    days = WEEK_DAYS
    if until is not None:
        days = WEEK_DAYS[:(date.fromisoformat(until).weekday() + 1) % 7]
    return {'region': 'actio', 'day': (None,) + days}

def _parse_obsidian(file_path, day_index, read_kwargs):
    """Yield (scope_key, scope_name, status, base, status_char, day_index) records.

    A project header — a task at indent 0 whose status is in [roles] project — opens a
    scope that the indented tasks under it belong to; any other indent-0 task closes it
    and belongs to the bare scope (`scope_key = None`). The header is context, never a
    row of its own, so it is not yielded.

    Grouping happens here, inside one note, so a header left open at the end of one
    note cannot adopt the indented tasks of the next. tcat's build_groups never faces
    that — it only ever sees a single note — but a tdiff week side concatenates eight.

    Scope keys are lowercased so [[Project Alpha]] and [[project alpha]] are one
    project; the display name is the first spelling seen.
    """
    scope_key = scope_name = scope_status = None
    for indent, status_char, name, _seq in parse_note(
            obsidian_lines(file_path), routines=INCLUDE_ROUTINES, **read_kwargs):
        base = _NEW_PREFIX_RE.sub('', name)
        if indent == 0:
            if status_char in PROJECT_STATUSES:
                scope_key, scope_name, scope_status = base.lower(), base, status_char
                continue
            scope_key = scope_name = scope_status = None
        # Re-bracket: parse_note yields the bare char, but tdiff stores statuses as
        # '[x]' and every consumer downstream indexes [1] for the char. Yielding the
        # bare form here fails silently rather than loudly.
        yield scope_key, scope_name, scope_status, base, f'[{status_char}]', day_index

def daily_path(d):
    return f'{DAILY_FOLDER}/{d}' if DAILY_FOLDER else d

def weekly_path(week_label):
    return f'{WEEKLY_FOLDER}/{week_label}' if WEEKLY_FOLDER else week_label

def cluster_records(records):
    """Cluster records that name the same logical task, using union-find. Two bases
    are the same task when their token sets are equal, or when one is a strict subset
    of the other and both start with the same token. Returns a list of clusters (each
    a list of records) in first-seen order of their root base."""
    bases_in_order, seen = [], set()
    for base, _, _ in records:
        if base not in seen:
            seen.add(base)
            bases_in_order.append(base)

    parent = {b: b for b in bases_in_order}
    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x
    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[ra] = rb

    # Bucketing on the two merge keys gives the same clusters as an all-pairs scan
    # without tokenizing (or comparing) every pair. Tokenless bases could only merge
    # by exact string equality, which distinct bases never satisfy — so skip them.
    by_tokens, by_first = {}, {}
    for b in bases_in_order:
        toks = _tokens(b)
        if not toks:
            continue
        key = frozenset(toks)
        by_tokens.setdefault(key, []).append(b)
        by_first.setdefault(toks[0], []).append((b, key))

    for group in by_tokens.values():
        for b in group[1:]:
            union(group[0], b)
    for group in by_first.values():
        for i, (a, sa) in enumerate(group):
            for b, sb in group[i + 1:]:
                if sa < sb or sb < sa:
                    union(a, b)

    by_root = {}
    for rec in records:
        by_root.setdefault(find(rec[0]), []).append(rec)

    clusters, emitted = [], set()
    for b in bases_in_order:
        r = find(b)
        if r in emitted:
            continue
        emitted.add(r)
        clusters.append(by_root[r])
    return clusters

def materialize(clusters):
    """Reduce each cluster to one (canonical_base, winning_status) pair."""
    tasks, order = {}, []
    for members in clusters:
        # Canonical: most recent day; tie-break by longest base.
        canonical = max(members, key=lambda r: (r[2], len(r[0])))[0]
        # Winning status: highest STATUS_PRIORITY; tie-break by latest day. The tuple
        # ran (day, priority) until now, which quietly made it the other way round —
        # the last note to mention a task won outright and [dedup] only settled a
        # same-day tie, so a Friday [/] beat a Tuesday [x].
        winning = max(members, key=lambda r: (STATUS_PRIORITY.get(r[1][1], 0), r[2]))[1]
        order.append(canonical)
        tasks[canonical] = winning
    return tasks, order

def week_span(d):
    """Return (sunday, saturday, label) for the US-format Sun-Sat week containing d."""
    if isinstance(d, str):
        d = date.fromisoformat(d)
    days_back = (d.weekday() + 1) % 7   # Mon=0..Sun=6 -> Sun=0
    sun = d - timedelta(days=days_back)
    sat = sun + timedelta(days=6)
    # The label's year is the *Saturday's*, not the Sunday's. Week 1 is the week
    # containing Jan 1, so a week straddling New Year belongs to the year it ends
    # in — which is what the vault's moment `gggg[-W]ww` filenames say. Anchoring
    # on the Sunday called Sun 2026-12-27 → Sat 2027-01-02 `2026-W53`, a file that
    # does not exist, and made the vault's real `2027-W01` unreachable by name.
    # Only the straddling week per year is affected; all others are unchanged.
    jan1 = date(sat.year, 1, 1)
    days_back = 0 if jan1.isoweekday() == 7 else jan1.isoweekday()
    week_num = ((sun - jan1).days + days_back) // 7 + 1
    return sun, sat, f"{sat.year}-W{week_num:02d}"

def week_entries(sunday, anchor=None, want_dailies=True, want_weekly=True):
    """(vault_path, day_index, read_kwargs) triples for one Sun-Sat week.

    The week has exactly two sources and `want_dailies` / `want_weekly` pick which to
    read: the seven daily notes, and the YYYY-W## weekly note at day_index 0 — lowest
    dedup priority, so it loses every tie against a daily.

    `anchor` (ISO date) is the day the week was derived from, and bounds it *strictly
    before* that day — on both sources: the dailies stop at anchor-1, and the weekly
    note's Actio whitelist stops one marker short. Two things fall out of the one
    bound. The anchor is the other side of the comparison, so it can never be compared
    against itself; and nothing dated after it can be outstanding as of it, which is
    what makes `tdiff wednesday` read "going into Wednesday" rather than "that week,
    Thursday and Friday included". A bare `today` looked right under the old
    anchor-only exclusion purely because tomorrow's note is usually empty.
    """
    entries = []
    if want_dailies:
        for i in range(7):
            d = (sunday + timedelta(days=i)).isoformat()
            if anchor is not None and d >= anchor:
                break
            entries.append((daily_path(d), i, WEEK_DAY_MODE))
    if want_weekly:
        _, _, week_label = week_span(sunday)
        entries.append((weekly_path(week_label), 0, weekly_mode(anchor)))
    return entries

def side_entries(side):
    """(vault_path, day_index, read_kwargs) triples backing one side of a comparison.
    side: ('day', date_str) | ('week', (sun, anchor, want_dailies, want_weekly))"""
    kind, key = side
    if kind == 'week':
        return week_entries(*key)
    return [(daily_path(key), 0, DAY_MODE)]

def side_paths(side):
    """Just the vault paths one side reads, in order."""
    return [path for path, _, _ in side_entries(side)]

def fetch_side(side):
    """Group one side's notes into a single virtual note, scoped by project.

    Returns {scope_key: (display_name, header_status, tasks, order)}, scope keys in
    first-seen order. Dedup runs once per scope and the scopes never merge, exactly as
    in tcat: a task written both bare and under a project keeps a row in each, because
    the header is real context and a bare occurrence should not swallow a project's
    copy. The consequence to expect is that scoping only ever *adds* rows.
    """
    entries = side_entries(side)
    prefetch([path for path, _, _ in entries])
    buckets, headers, order = {}, {}, []
    for path, day_index, kwargs in entries:
        for skey, sname, sstatus, base, status, di in _parse_obsidian(
                path, day_index, kwargs):
            if skey not in buckets:
                buckets[skey], headers[skey] = [], (sname, sstatus)
                order.append(skey)
            buckets[skey].append((base, status, di))
    scopes = {k: headers[k] + materialize(cluster_records(v))
              for k, v in buckets.items()}
    return scopes, order

def _tokenset(s):
    return set(s.lower().split())

def jaccard(sa, sb):
    if not sa and not sb:
        return 1.0
    overlap = len(sa & sb)
    return overlap / (len(sa) + len(sb) - overlap)

def prefix_sim(a, b):
    prefix_len = 0
    for ca, cb in zip(a.lower(), b.lower()):
        if ca != cb:
            break
        prefix_len += 1
    return (2 * prefix_len) / (len(a) + len(b))

def best_match(name, candidates):
    """Closest candidate above the similarity threshold, or None.
    `candidates` is a list of (name, tokenset) pairs; ties go to the earlier one."""
    na, la = _tokenset(name), len(name)
    first_char = name[:1].lower()
    best, best_score = None, 0
    for c, nc in candidates:
        # Neither metric can reach the threshold when the shorter side is too small.
        # Once a match exists, candidates that can only tie it cannot replace it.
        token_ceiling = (min(len(na), len(nc)) / max(len(na), len(nc))
                         if na or nc else 1.0)
        same_first = c[:1].lower() == first_char
        prefix_ceiling = (2 * min(la, len(c)) / (la + len(c))) if same_first else 0.0
        ceiling = max(token_ceiling, prefix_ceiling)
        if ceiling < JACCARD_THRESHOLD or ceiling <= best_score:
            continue

        score = jaccard(na, nc)
        # Prefix similarity can only change the outcome when its length-based ceiling
        # beats both this pair's Jaccard score and the running best.
        if same_first:
            if prefix_ceiling > max(score, best_score):
                score = max(score, prefix_sim(name, c))
        if score > best_score:
            best, best_score = c, score
    if best and best_score >= JACCARD_THRESHOLD:
        return best
    return None

