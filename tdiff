def side_label(side):
    """Human-facing name for one side: the date, or the YYYY-W## of a week."""
    kind, key = side
    return week_span(key[0])[2] if kind == 'week' else key

def side_json(side):
    """Describe one side of the comparison, including the vault files it read — which
    is where -D/-W's narrowing and the one-positional form's exclusion are observable,
    since neither shows up anywhere else in the output."""
    kind, key = side
    out = {'kind': kind, 'label': side_label(side)}
    if kind == 'week':
        sun, sat, _ = week_span(key[0])
        out['start'], out['end'] = sun.isoformat(), sat.isoformat()
    out['files'] = side_paths(side)
    return out

def emit_json(doc):
    json.dump(doc, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write('\n')

# ── Diff ──────────────────────────────────────────────────────────────────────

# One batched read for both sides, so every vault call overlaps.
prefetch([p for side in (side_a, side_b) for p in side_paths(side)])

a_scopes, a_order = fetch_side(side_a)
b_scopes, b_order = fetch_side(side_b)

# Types: 0=deleted, 1=added, 2=changed, 3=same
# Rows are (scope_key, name, type, row_dict); row_dict is both the JSON record and what
# render() turns into a text line, so the two output modes can't drift apart.
#   name        canonical task name (A's for deleted/changed, B's for added)
#   status      effective status char — B's for added/changed/same, A's for deleted
#   old_status  A's status char (changed rows only)
#   new_name    B's name (changed rows only, and only when the fuzzy match renamed it)
#   project     the project the row sits under; absent on a bare row
TYPE_NAMES = {0: 'deleted', 1: 'added', 2: 'changed', 3: 'same'}

# scope_key -> (display_name, header_status) for every project either side saw. B wins
# a clash, matching the effective-status rule rows follow: B is the later statement.
PROJECTS = {k: v[:2] for k, v in a_scopes.items() if k is not None}
PROJECTS.update({k: v[:2] for k, v in b_scopes.items() if k is not None})

def row(scope, typ, name, status, old_status=None, new_name=None):
    r = {'type': TYPE_NAMES[typ], 'name': name, 'status': status}
    if old_status is not None:
        r['old_status'] = old_status
    if new_name is not None:
        r['new_name'] = new_name
    if scope is not None:
        r['project'] = PROJECTS[scope][0]
    return (scope, name, typ, r)

def render(r, indent=''):
    st = f"[{r['status']}]"
    typ = r['type']
    if typ == 'same':
        return f"{DIM}{indent}== {st}  {r['name']}{RESET}"
    if typ == 'deleted':
        return f"{RED}{indent}-- {st}  {r['name']}{RESET}"
    if typ == 'added':
        return f"{GREEN}{indent}++ {st}  {r['name']}{RESET}"
    old = f"[{r['old_status']}]"
    if 'new_name' in r:
        return f"{YELLOW}{indent}~~ {old} {r['name']} → {st} {r['new_name']}{RESET}"
    return f"{YELLOW}{indent}~~ {old} → {st}  {r['name']}{RESET}"

def diff_scope(scope, a_tasks, a_order, b_tasks, b_order):
    """Diff one project's tasks against the other side's copy of that project.

    Scopes are diffed independently and fuzzy matching never crosses one, so a task
    that moved between projects reads as deleted there and added here rather than
    silently staying put. A scope only one side has yields all-deleted or all-added,
    which is how a project appearing or disappearing shows up at all.
    """
    rows = []
    a_names, b_names = set(a_tasks), set(b_tasks)
    used_a, used_b = set(), set()

    # Pass 1: exact name matches
    for name in a_names & b_names:
        used_a.add(name)
        used_b.add(name)
        if a_tasks[name] != b_tasks[name]:
            rows.append(row(scope, 2, name, b_tasks[name][1],
                            old_status=a_tasks[name][1]))
        else:
            rows.append(row(scope, 3, name, a_tasks[name][1]))

    # Pass 2: fuzzy match remaining
    remaining_a = [n for n in a_order if n not in used_a]
    remaining_b = [n for n in b_order if n not in used_b]
    # Candidates carry their token sets so pass 2 tokenizes each name once, not once
    # per comparison; matched entries are dropped instead of re-filtered every round.
    candidates = [(n, _tokenset(n)) for n in remaining_b]

    for a_name in remaining_a:
        match = best_match(a_name, candidates)
        if match:
            used_b.add(match)
            candidates = [pair for pair in candidates if pair[0] != match]
            rows.append(row(scope, 2, a_name, b_tasks[match][1],
                            old_status=a_tasks[a_name][1],
                            new_name=match if match != a_name else None))
        else:
            rows.append(row(scope, 0, a_name, a_tasks[a_name][1]))

    for b_name in remaining_b:
        if b_name not in used_b:
            rows.append(row(scope, 1, b_name, b_tasks[b_name][1]))
    return rows

output = []
for scope in a_order + [k for k in b_order if k not in a_scopes]:
    _, _, a_tasks, a_names_order = a_scopes.get(scope, (None, None, {}, []))
    _, _, b_tasks, b_names_order = b_scopes.get(scope, (None, None, {}, []))
    output += diff_scope(scope, a_tasks, a_names_order, b_tasks, b_names_order)

# Projects first, then the bare rows — so the rows that carry their own context lead and
# the familiar flat list follows. Projects are ordered by their *header* status and never
# by their children's: sorting a project by the statuses inside it would let one urgent
# task drag a whole project to the top.
#
# Rows inside a group go type, then status, then name. Type outranks status because the
# question a diff answers is what moved, not what state it is in — reading straight down
# the added block and then the deleted block is the point of the tool. Status orders
# within a type, which is where [order].statuses does its work.
TYPE_RANK = {1: 0, 0: 1, 2: 2, 3: 3}    # added, deleted, changed, same — the summary's order
output.sort(key=lambda x: (x[0] is None,
                           display_rank(PROJECTS[x[0]][1]) if x[0] else 0,
                           PROJECTS[x[0]][0].lower() if x[0] else '',
                           TYPE_RANK[x[2]],
                           display_rank(x[3]['status']),
                           x[1].lower()))

# ── Filter ────────────────────────────────────────────────────────────────────

counts = {0: 0, 1: 0, 2: 0, 3: 0}
kept = []
seen_statuses = set()
for scope, _, typ, r in output:
    eff = r['status']
    seen_statuses.add(eff)
    # Structural: a project status on an ordinary row is a nested header, not work.
    # A project's own header never reaches here — it is a scope, not a row.
    if eff in PROJECT_STATUSES:
        continue
    if suppressed(eff):                # [roles] hide, and -I on any settled row
        continue
    if not status_match(eff):          # -S: show only matching effective statuses
        continue
    if not type_match(typ):            # -T: show only matching row types
        continue
    counts[typ] += 1
    kept.append((scope, r))

report_unlisted(seen_statuses)

# ── Output ────────────────────────────────────────────────────────────────────

if args.json:
    emit_json({
        'mode': 'diff',
        'a': side_json(side_a),
        'b': side_json(side_b),
        # Flat, with the project named on each row rather than nested children: the
        # filters and the summary then need no shape of their own, and grouping stays
        # a rendering concern. tcat's nested envelope had one consumer, -E, which is
        # gone.
        'rows': [r for _, r in kept],
        'summary': {
            'added':   counts[1],
            'deleted': counts[0],
            'changed': counts[2],
            'same':    counts[3],
            'total':   sum(counts.values()),
        },
    })
    finish()

# A header prints only when a row under it survived the filters — the sort has already
# put every project's rows together, so tracking the last one seen is enough.
last_scope = ...
for scope, r in kept:
    if scope != last_scope:
        if scope is not None:
            name, status = PROJECTS[scope]
            # Uncoloured on purpose: the diff type owns the row colours beneath it, and
            # a header dimmed to match nothing read as less structural than it is.
            print(f"[{status}] {name}")
        last_scope = scope
    print(render(r, indent='   ' if scope is not None else ''))

if not args.no_summary:
    total = sum(counts.values())
    parts = [
        f"{GREEN}{counts[1]} added{RESET}",
        f"{RED}{counts[0]} deleted{RESET}",
        f"{YELLOW}{counts[2]} changed{RESET}",
        f"{DIM}{counts[3]} same{RESET}",
        f"{total} total",
    ]
    projects = len({s for s, _ in kept if s is not None})
    if projects:
        parts.insert(-1, f"{projects} project" + ('' if projects == 1 else 's'))
    print('  ' + f"  {DIM}·{RESET}  ".join(parts))

finish()
