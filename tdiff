# intercept them and turn them into a safe token first.
raw = sys.argv[1:]
safe = [('__NEG__' + a[1:]) if re.fullmatch(r'-\d+', a) else a for a in raw]
args = parser.parse_args(safe)

load_config(args.config, parser.error)
INCLUDE_ROUTINES = args.routines

def restore(s):
    if s.startswith('__NEG__'):
        return '-' + s[7:]
    return s

_ISO_RE = re.compile(r'\d{4}-\d{2}-\d{2}')
_OFF_RE = re.compile(r'([-+])(\d+)')

# One line each so tools/check-core-sync.sh, which compares constants by their
# assignment line, actually covers them. Both the full name and its 3-letter prefix
# map to the same index.
_WEEKDAY_NAMES = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday']
WEEKDAYS = {n[:k]: i for i, n in enumerate(_WEEKDAY_NAMES) for k in (3, len(n))}

_WEEK_SHORT_RE = re.compile(r'[wW](\d{1,2})$')
_WEEK_FULL_RE  = re.compile(r'[wW](\d{4}-W\d{2})$')

def resolve_date(s):
    today = date.today()
    if s in ('today', '0'):
        return today.isoformat()
    if s == 'yesterday':
        return (today - timedelta(days=1)).isoformat()
    if s == 'tomorrow':
        return (today + timedelta(days=1)).isoformat()
    low = s.lower()
    if low in WEEKDAYS:
        # Backwards: the most recent occurrence at or before today. A future day
        # has no tasks yet, so resolving forwards would always come back empty.
        days_back = (today.weekday() - WEEKDAYS[low]) % 7
        return (today - timedelta(days=days_back)).isoformat()
    m = _OFF_RE.fullmatch(s)
    if m:
        n = int(m.group(2))
        if n < 1:
            parser.error(f"invalid date: {s!r} (use 0 for today)")
        delta = -n if m.group(1) == '-' else n
        return (today + timedelta(days=delta)).isoformat()
    if _ISO_RE.fullmatch(s):
        try:
            return date.fromisoformat(s).isoformat()
        except ValueError:
            parser.error(f"invalid date: {s!r}")
    parser.error(
        f"invalid date: {s!r} (expected YYYY-MM-DD, 'today', 'yesterday', "
        f"'tomorrow', '0', -N/+N, a weekday name, or w##)"
    )

def resolve_week_label(s):
    """Return 'YYYY-W##' if s is a w## specifier, else None."""
    m = _WEEK_FULL_RE.fullmatch(s)
    if m:
        return m.group(1)
    m = _WEEK_SHORT_RE.fullmatch(s)
    if m:
        return f'{date.today().year}-W{int(m.group(1)):02d}'
    return None

def _week_label_to_sunday(week_label):
    """Convert 'YYYY-W##' (US convention: week 1 contains Jan 1, weeks start Sunday)."""
    year, week_num = int(week_label[:4]), int(week_label[6:])
    jan1 = date(year, 1, 1)
    days_back = 0 if jan1.isoweekday() == 7 else jan1.isoweekday()
    return jan1 - timedelta(days=days_back) + timedelta(weeks=week_num - 1)

# A week has two sources; -D and -W pick one, naming neither picks both. argparse
# makes them mutually exclusive, so this pair is the whole of what the flags mean.
WANT_DAILIES = not args.weekly
WANT_WEEKLY  = not args.dailies

raw_a = restore(args.date_a)
raw_b = restore(args.date_b) if args.date_b is not None else None
week_label_a = resolve_week_label(raw_a)
week_label_b = resolve_week_label(raw_b) if raw_b is not None else None

# side_a / side_b:
#   ('day', date_str) | ('week', (sunday, anchor, want_dailies, want_weekly))
side_a = side_b = None

def base_side(raw, week_label):
    """What a positional names on its own: a w## names its whole Sun-Sat week, read
    through whichever sources -D/-W left standing; anything else names a daily note.

    A date is never promoted to its week. -D/-W narrow a week that is already there,
    which is why `tdiff mon fri -D` is an error rather than a second way to spell
    `tdiff w33 w34 -D`."""
    if week_label:
        sun = _week_label_to_sunday(week_label)
        return ('week', (sun, None, WANT_DAILIES, WANT_WEEKLY))
    return ('day', resolve_date(raw))

if raw_b is not None:
    side_a = base_side(raw_a, week_label_a)
    side_b = base_side(raw_b, week_label_b)
    if side_a[0] == 'week' and side_b[0] == 'week' and side_a[1][0] == side_b[1][0]:
        parser.error("both positionals name the same Sun-Sat week; "
                     "comparing it against itself would be a no-op")
elif week_label_a:
    # One w##: its weekly note against its own dailies. The note is the anchor, so it
    # drops out of the week built around it — which leaves exactly the two sources,
    # one per side. The weekly note is what was written first, so it takes the A side.
    #
    # Both flags are rejected here rather than ignored: -D would remove the A side and
    # -W the B side, and either way the command already has a shorter spelling.
    if args.dailies or args.weekly:
        parser.error("a lone w## already compares the weekly note against that week's "
                     "dailies; -D/-W would leave one side empty")
    sun = _week_label_to_sunday(week_label_a)
    side_a = ('week', (sun, None, False, True))
    side_b = ('week', (sun, None, True, False))
else:
    # One date: the week around it against the date itself. The date is the anchor and
    # drops back out of that week, so it is never compared against itself.
    anchor = resolve_date(raw_a)
    sun, _, _ = week_span(anchor)
    side_a = ('week', (sun, anchor, WANT_DAILIES, WANT_WEEKLY))
    side_b = ('day', anchor)

# -D/-W narrow a week. With two dates there is no week to narrow, and promoting them
# both would silently answer a different question than the one that was asked.
if (args.dailies or args.weekly) and 'week' not in (side_a[0], side_b[0]):
    parser.error("-D/-W need a week to narrow; name one with w## "
                 "(e.g. 'tdiff w33 w34 -D') or give a single date")

status_filter = None            # (set_of_chars, negate)
